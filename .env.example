# Copy this file to .env and fill in what you need.

# --- Claude (optional summary provider; Ollama is always the default) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Fixed USD -> AUD rate used for the estimated cost shown in each meeting's notes
USD_TO_AUD=1.55

# --- Ollama (local summary, the default) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_NUM_CTX=16384
# How long Ollama keeps the model in RAM after a summary (a 14B model is ~10 GB). Ollama's own
# default is 5m. Use e.g. 5m to avoid the ~7 s reload between meetings, or 0 to unload at once.
OLLAMA_KEEP_ALIVE=30s

# Language the notes are written in (e.g. English, Vietnamese)
NOTES_LANGUAGE=English

# --- Speech to text (always local) ---
# Parakeet (English only) is the default engine. Leave TRANSCRIBE_MODEL empty to use it.
TRANSCRIBE_MODEL=parakeet:mlx-community/parakeet-tdt-0.6b-v2
# Leave empty to auto-detect; "en" is faster and more reliable for English meetings
WHISPER_LANGUAGE=en
# Names and jargon that Whisper often mishears
WHISPER_VOCABULARY=Playwright, Jira, Confluence, Cognito, OpenAPI, Swagger, Cam, Josh, Irem

# Transcribe while recording so the transcript is ready right after you press Stop.
# Set LIVE_TRANSCRIBE=0 to transcribe only after the recording ends.
LIVE_TRANSCRIBE=1
# Seconds of audio per live chunk (cut at the nearest pause). Smaller = captions appear
# sooner but with less context for Whisper; 10-20 is a good range.
LIVE_CHUNK_SEC=10
# Show grey provisional captions every N seconds of new audio (0 = off). They are replaced
# by the final text when the chunk finishes. Costs extra Whisper work while recording.
LIVE_PARTIAL_SEC=2

# Ask "Record this meeting?" when Microsoft Teams starts using the microphone (macOS 14.4+).
# MEETING_DETECT_APPS is a comma-separated list of bundle-id prefixes, e.g. add ,us.zoom.xos for Zoom.
MEETING_DETECT=1
MEETING_DETECT_APPS=com.microsoft.teams
# Stop the recording of a meeting (started by the dialog, or by hand while Teams held the mic)
# once the app has released the mic for this many seconds
# (Teams keeps the mic while muted and releases it right after Leave); the silence after the release
# is cut from the recording. If it takes the mic again sooner, a dialog asks whether it is a new
# meeting (back-to-back call) or the same one (reconnect).
MEETING_AUTO_STOP=1
MEETING_END_GRACE_SEC=40

# Label each transcript line "Me" (your microphone) or "Others" (system audio / BlackHole).
# Needs both a microphone and BlackHole selected. Works without headphones: the sound of
# the speakers leaking into the mic is measured and discounted. Set to 0 to turn off.
LABEL_SPEAKERS=1
# After the notes are saved, tell the other participants apart in the background ("Speaker 1",
# "Speaker 2", ... instead of "Others") by clustering voices on the system-audio track. Needs
# BlackHole, and two models fetched once with:  .venv/bin/python diarize.py --download
# It is skipped silently while they are missing. Set to 0 to turn off.
DIARIZE=1
# CPU threads for it (about 7x real time on 4 threads, so a 45-minute meeting takes a few minutes).
# DIARIZE_THREADS=4
# Optional voiceprint ("My voice" in Settings): recognises your voice itself, so labels stay right
# without headphones, with the mic muted, or when people talk over each other. The profile is
# biometric data: it is stored here, outside the project, and never sent anywhere.
# VOICEPRINT_DIR=~/.meeting-notes
# Similarity (0-1) a segment needs to count as you. Leave unset to use the value measured at enrolment;
# each transcript segment keeps its "voice" score, so you can see what a good value is.
# VOICEPRINT_THRESHOLD=0.45

# Echo cancellation: the system track (what the loudspeakers play) is subtracted from the mic
# when the recording stops, so the other participants' voices on your mic no longer pass for
# yours. Set to 0 to turn off.
ECHO_CANCEL=1
# Keep the raw microphone and system audio (and the echo-cancelled mic) in the meeting folder,
# under tracks/, for tuning. This is real meeting audio and is never deleted automatically.
KEEP_TRACKS=0

# Recordings are deleted once the notes are saved (a failed run keeps them for retry).
# Set to 1 to keep every audio file. To keep just one meeting (e.g. for QA), add
# "keep_audio": true to its meta.json.
KEEP_AUDIO=0

# After each meeting is processed the speech model is unloaded and GPU memory is returned to the OS
# (the server otherwise holds many GB while idle). Set to 1 to keep the model loaded for faster starts.
KEEP_MODEL_LOADED=0

# Where meeting folders are saved
NOTES_DIR=~/MeetingNotes
PORT=8765
